# CONFIGURATION VPN (GLUETUN / MULLVAD)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=0.0.0.0/32 # Ex: 10.90.145.108
SERVER_CITIES=

# RÉSEAU LOCAL
LAN_SUBNET=192.168.1.0/24

# FUSEAU HORAIRE
TZ=Europe/Brussels

# Port Frontend
Frontend_Port=3000

# CONFIGURATION QBITTORRENT
QBIT_HOST=http://localhost:8080
QBIT_USER=admin
# Mot de passe : 6 caractères minimum
QBIT_PASS=

# Modèle Ollama utilisé par le backend
OLLAMA_MODEL=llama3.1

# CONFIGURATION PROWLARR (clé API : Settings → General dans Prowlarr)
PROWLARR_API_KEY=

# CHEMINS ET DOSSIERS Jellyfin
DIR_DOWNLOADS="/downloads"
JELLYFIN_HOST=0.0.0.0 # Ex: 192.168.1.5
JELLYFIN_USER=
DIR_JELLYFIN=/mnt/contenu